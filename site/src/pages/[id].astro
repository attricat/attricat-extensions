---
import type { GetStaticPaths } from 'astro';
import { ArrowLeft, ArrowUpRight, TriangleAlert } from 'lucide-react';
import BaseLayout from '../layouts/BaseLayout.astro';
import { ExtensionIcon } from '../components/ExtensionIcon';
import { extensions, type Extension } from '../registry';
import { loadReadme } from '../readme';
import { links } from '../links';
import '../styles/readme.css';

export const getStaticPaths = (() =>
  extensions.map((extension) => ({ params: { id: extension.id }, props: { extension } }))) satisfies GetStaticPaths;

interface Props {
  extension: Extension;
}

/** Search engines show about this many characters of a description. */
const DESCRIPTION_LENGTH = 160;
/** Characters of a digest shown before the rest is elided. */
const DIGEST_PREFIX = 12;

const { extension } = Astro.props;
const readme = await loadReadme(extension);
const latest = extension.versions[0];
const pageUrl = new URL(extension.path, Astro.site).href;
const indexUrl = new URL('/', Astro.site).href;

const truncate = (text: string, length: number) =>
  text.length <= length ? text : `${text.slice(0, length - 1).replace(/\s+\S*$/, '')}…`;
const description = truncate(
  readme?.summary && readme.summary.length > extension.description.length ? readme.summary : extension.description,
  DESCRIPTION_LENGTH,
);
const [owner, repository] = extension.repository.split('/');

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: extension.name,
    description: extension.description,
    url: pageUrl,
    identifier: extension.id,
    applicationCategory: 'BusinessApplication',
    applicationSubCategory: 'Attricat extension',
    operatingSystem: 'Attricat',
    ...(extension.iconUrl ? { image: extension.iconUrl } : {}),
    ...(latest ? { softwareVersion: latest.version.replace(/^v/, '') } : {}),
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    sameAs: extension.repositoryUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Extensions', item: indexUrl },
      { '@type': 'ListItem', position: 2, name: extension.name, item: pageUrl },
    ],
  },
];
---

<BaseLayout
  title={`${extension.name} · Attricat extensions`}
  description={description}
  image={extension.iconUrl ?? undefined}
  structuredData={structuredData}
>
  <section class="intro">
    <div class="shell intro-inner">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/"><ArrowLeft size={16} aria-hidden="true" />Extensions</a>
      </nav>
      <div class="title-row">
        <ExtensionIcon client:load url={extension.iconUrl} className="icon" size={36} />
        <div class="titles">
          <h1>{extension.name}</h1>
          <code class="id">{extension.id}</code>
        </div>
      </div>
      <p class="lede">{extension.description}</p>
      <div class="actions">
        <a class="button" href={extension.repositoryUrl}>
          View on GitHub
          <ArrowUpRight size={18} aria-hidden="true" />
        </a>
        <a class="button button-secondary" href={extension.releasesUrl}>Releases</a>
      </div>
    </div>
  </section>

  <div class="shell layout">
    <article class="readme-column" aria-label="README">
      {
        readme ? (
          <>
            <div class="readme" set:html={readme.html} />
            <p class="source">
              From <a href={readme.sourceUrl}>{extension.repository}/README.md</a>
            </p>
          </>
        ) : (
          <div class="no-readme">
            <p>We couldn't load this extension's README when the site was built.</p>
            <a class="text-link" href={extension.repositoryUrl}>
              Read it on GitHub
              <ArrowUpRight size={16} aria-hidden="true" />
            </a>
          </div>
        )
      }
    </article>

    <aside class="sidebar">
      <section class="panel" aria-labelledby="install-heading">
        <h2 id="install-heading">Install</h2>
        <ol class="steps">
          <li>In Attricat, open <strong>Manage → Extensions → Marketplace</strong>.</li>
          <li>Find <strong>{extension.name}</strong> and select <strong>Inspect</strong>.</li>
          <li>Pick a reviewed release and select <strong>Install</strong>.</li>
          <li>Review and grant its permissions, then <strong>Enable</strong> it.</li>
        </ol>
        <p class="hint">Or with the CLI:</p>
        <pre class="cli"><code>acli extension install --owner {owner} --repository {repository} --release-id &lt;id&gt;</code></pre>
        <a class="text-link" href={links.docsInstall}>
          Installing extensions
          <ArrowUpRight size={16} aria-hidden="true" />
        </a>
      </section>

      <section class="panel" aria-labelledby="versions-heading">
        <h2 id="versions-heading">Reviewed versions</h2>
        {
          extension.versions.length > 0 ? (
            <table class="versions">
              <thead>
                <tr>
                  <th scope="col">Version</th>
                  <th scope="col">Host API</th>
                  <th scope="col">SHA-256</th>
                </tr>
              </thead>
              <tbody>
                {extension.versions.map((version) => (
                  <tr>
                    <td><code>{version.version}</code></td>
                    <td><code>{version.host_api}</code></td>
                    <td>
                      <code title={version.sha256}>{version.sha256.slice(0, DIGEST_PREFIX)}…</code>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          ) : (
            <p class="warning">
              <TriangleAlert size={16} aria-hidden="true" />
              No release has been reviewed yet, so Attricat can't install this extension from the registry.
            </p>
          )
        }
      </section>

      <section class="panel" aria-labelledby="details-heading">
        <h2 id="details-heading">Details</h2>
        <dl class="details">
          <div><dt>Extension ID</dt><dd><code>{extension.id}</code></dd></div>
          <div><dt>Repository</dt><dd><a href={extension.repositoryUrl}><code>{extension.repository}</code></a></dd></div>
          <div><dt>Registry</dt><dd><a href={links.registryFile}>Official Attricat registry</a></dd></div>
        </dl>
      </section>
    </aside>
  </div>
</BaseLayout>

<style>
  .intro { background: var(--surface); border-bottom: 1px solid var(--border); }
  .intro-inner { display: grid; gap: var(--space-4); justify-items: start; padding-block: var(--space-6) var(--space-10); }
  .breadcrumbs a { align-items: center; color: var(--muted); display: inline-flex; font-size: var(--label-size); font-weight: 600; gap: var(--space-1); }
  .breadcrumbs a:hover { color: var(--primary); }
  .title-row { align-items: center; display: flex; gap: var(--space-4); margin-top: var(--space-4); }
  .title-row :global(.icon) {
    align-items: center;
    background: var(--inset);
    border: 1px solid var(--subtle);
    border-radius: var(--radius-surface);
    color: var(--primary);
    display: inline-flex;
    flex: none;
    height: 56px;
    justify-content: center;
    width: 56px;
  }
  .title-row :global(.icon img) { display: block; }
  .titles { display: grid; gap: var(--space-1); min-width: 0; }
  h1 {
    font-size: clamp(28px, 4vw, var(--marketingHeading-size));
    font-weight: var(--marketingHeading-weight);
    letter-spacing: var(--marketingHeading-tracking);
    line-height: var(--marketingHeading-lh);
    text-wrap: balance;
  }
  .id { color: var(--muted); font-size: var(--code-size); }
  .lede { color: var(--muted); font-size: 16px; max-width: 70ch; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-2); }

  .layout { align-items: start; display: grid; gap: var(--space-8); grid-template-columns: minmax(0, 1fr) 340px; padding-top: var(--space-8); }
  .readme-column { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-surface); min-width: 0; padding: var(--space-8); }
  .source { border-top: 1px solid var(--subtle); color: var(--muted); font-size: var(--caption-size); margin-top: var(--space-8); padding-top: var(--space-4); }
  .source a { color: var(--primary); }
  .no-readme { color: var(--muted); display: grid; gap: var(--space-3); justify-items: start; }

  .sidebar { display: grid; gap: var(--space-4); position: sticky; top: calc(68px + var(--space-6)); }
  .panel { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-surface); display: grid; gap: var(--space-3); padding: var(--space-5); }
  .panel h2 { font-size: var(--label-size); font-weight: var(--label-weight); line-height: var(--label-lh); }
  .steps { color: var(--muted); display: grid; gap: var(--space-2); margin: 0; padding-left: var(--space-5); }
  .steps strong { color: var(--fg); font-weight: 600; }
  .hint { color: var(--muted); font-size: var(--caption-size); }
  .cli { background: var(--inset); border: 1px solid var(--subtle); border-radius: var(--radius-control); font-size: var(--code-size); line-height: var(--code-lh); margin: 0; overflow-x: auto; padding: var(--space-3); white-space: pre-wrap; word-break: break-word; }
  .text-link { align-items: center; color: var(--primary); display: inline-flex; font-size: var(--label-size); font-weight: 600; gap: var(--space-1); justify-self: start; }
  .text-link:hover { text-decoration: underline; text-underline-offset: 3px; }

  .versions { border-collapse: collapse; font-size: var(--label-size); width: 100%; }
  .versions th { color: var(--muted); font-size: var(--caption-size); font-weight: 600; padding: 0 var(--space-2) var(--space-2) 0; text-align: left; }
  .versions td { border-top: 1px solid var(--subtle); padding: var(--space-2) var(--space-2) var(--space-2) 0; }
  .versions code { font-size: var(--code-size); }
  .warning { align-items: flex-start; background: var(--warning-tint); border-radius: var(--radius-control); color: var(--warning-fg); display: flex; font-size: var(--label-size); gap: var(--space-2); padding: var(--space-3); }
  .warning :global(svg) { flex: none; margin-top: 2px; }

  .details { display: grid; gap: var(--space-3); margin: 0; }
  .details dt { color: var(--muted); font-size: var(--caption-size); }
  .details dd { font-size: var(--label-size); margin: 0; overflow-wrap: anywhere; }
  .details code { font-size: var(--code-size); }
  .details a { color: var(--primary); }
  .details a:hover { text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 960px) {
    .layout { grid-template-columns: 1fr; }
    .sidebar { grid-row: 1; position: static; }
  }
  @media (max-width: 640px) {
    .readme-column { padding: var(--space-5); }
  }
</style>

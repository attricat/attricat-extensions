---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found · Attricat extensions" description="There is no page at this address." noindex>
  <section class="shell missing">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p>If a link sent you to an extension, it may have been renamed or removed from the registry.</p>
    <a class="button" href="/">Browse extensions</a>
  </section>
</BaseLayout>

<style>
  .missing { display: grid; gap: var(--space-4); justify-items: start; padding-block: var(--space-20); }
  h1 { font-size: clamp(28px, 4vw, var(--marketingHeading-size)); font-weight: var(--marketingHeading-weight); letter-spacing: var(--marketingHeading-tracking); line-height: var(--marketingHeading-lh); }
  p:not(.eyebrow) { color: var(--muted); max-width: 60ch; }
</style>
